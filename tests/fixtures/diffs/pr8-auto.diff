+  if [[ -z "$comments" ]]; then
+    echo "    -> No new comments"
+    return 0
+  fi
+  
+  local cmd_response=""
+  
+  local owner_repo="$repo/$pr_number"
+  
+  echo "$comments" | while IFS='|' read -r comment_id created_at body; do
+    [[ -z "$body" ]] && continue
