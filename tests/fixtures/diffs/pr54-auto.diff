+    # ------------------------------------------------------------------ [port]
+    def create(self, repository: str, title: str, body: str) -> Issue:
+        """POST a new issue to *repository* and return the Issue entity."""
+
+        # -- [http] POST issue -----------------------------------------------
+        path = f"/repos/{repository}/issues"
+        try:
+            response = self._client.post(path, {"title": title, "body": body})
