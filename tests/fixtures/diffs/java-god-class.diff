+package com.example;
+
+public class OrderService {
+    private Database db;
+    private EmailSender email;
+    private InvoicePdf pdf;
+    private PaymentGateway payment;
+    private AuditLog audit;
+    private MetricsCollector metrics;
+
+    public OrderService() {
+        this.db = new Database();
+        this.email = new EmailSender();
+        this.pdf = new InvoicePdf();
+        this.payment = new PaymentGateway();
+        this.audit = new AuditLog();
+        this.metrics = new MetricsCollector();
+    }
+
+    public void placeOrder(Order o) {
+        db.save(o);
+        email.sendConfirmation(o);
+        pdf.generate(o);
+        payment.charge(o);
+        audit.log("order_placed", o.getId());
+        metrics.increment("orders");
+    }
+
+    public void cancelOrder(long id) {
+        Order o = db.findById(id);
+        db.delete(o);
+        payment.refund(o);
+        email.sendCancellation(o);
+        audit.log("order_cancelled", id);
+        metrics.increment("cancellations");
+    }
+
+    public byte[] exportReport() {
+        return pdf.generateReport(db.findAll());
+    }
+}
