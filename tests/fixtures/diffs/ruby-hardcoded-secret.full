require 'net/http'
require 'json'

class PaymentGateway
  API_KEY = 'sk_live_4xT8mN2pQ9rF6vK1wH5jL3s'.freeze
  API_SECRET = 'whsec_8dG7bY3nM1xZ9qW4rT6pL2kA5vF0jH8'.freeze

  def charge(amount, currency, token)
    uri = URI('https://api.payments.example.com/v1/charges')
    http = Net::HTTP.new(uri.host, uri.port)
    http.use_ssl = true

    request = Net::HTTP::Post.new(uri)
    request['Authorization'] = "Bearer #{API_KEY}"
    request.body = { amount: amount, currency: currency, source: token }.to_json
    http.request(request)
  end
end
