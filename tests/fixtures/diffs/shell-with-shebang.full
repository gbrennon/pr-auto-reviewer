#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"

usage() {
  echo "Usage: $0 <environment>"
  echo "  environment: staging | production"
  exit 1
}

deploy() {
  local env="$1"
  echo "Deploying to $env..."
  rsync -avz --delete "$REPO_ROOT/dist/" "server:/var/www/$env/"
  echo "Done!"
}

main() {
  if [[ $# -ne 1 ]]; then
    usage
  fi
  deploy "$1"
}

main "$@"
