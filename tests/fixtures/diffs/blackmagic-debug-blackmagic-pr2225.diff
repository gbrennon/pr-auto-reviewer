 	const uint8_t access_length = 1U << access_width;
 
+	bool use_abstractauto = false;
+	/* If Abstract Command Autoexec is supported, then use efficient sequential reads */
+	if (len / access_length > 1U && (hart->flags & RV_HART_FLAG_ABSTRACTAUTO) != 0U)
