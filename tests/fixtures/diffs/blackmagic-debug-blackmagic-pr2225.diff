 	riscv_csr_read(hart, RV_GPR_A0, &a0_save);
 	riscv_csr_read(hart, RV_GPR_A1, &a1_save);
 
-	const uint8_t *const data = (const uint8_t *)src;
-	for (size_t offset = 0; offset < len; offset += access_length) {
+	do {
 		/* Prepare the destination address in GPR A0 */
-		const uint32_t dest_a0 = dest + offset;
+		const uint32_t dest_a0 = dest;
 		if (!riscv_csr_write(hart, RV_GPR_A0, &dest_a0))
 			break;
 
 		/* Pack the data to write into GPR A1 */
-		uint32_t value = riscv32_pack_data(data + offset, access_width);
+		uint32_t value = riscv32_pack_data(src, access_width);
 		if (!riscv_dm_write(hart->dbg_module, RV_DM_DATA0, value))
 			break;
 		/* Copy the write value from DATA0 to GPR A1 and launch the progbuf postexec */
@@ -711,8 +746,24 @@ static void riscv32_progbuf_mem_write(
 		result &= riscv_command_wait_complete(hart);
 		if (!result)
 			break;
+
+		/* If Abstract Command Autoexec is supported, then use efficient sequential reads */
+		if (len / access_length > 1 && hart->flags & RV_HART_FLAG_ABSTRACTAUTO)
+			riscv_dm_write(hart->dbg_module, RV_DM_ABST_AUTO, RV_ABST_AUTO_DATA0);
+	} while(false);
+
+	const uint8_t *const data = (const uint8_t *)src;
+	for (size_t offset = access_length; offset < len; offset += access_length) {
+		/* Pack the data to write into GPR A1 */
+		uint32_t value = riscv32_pack_data(data + offset, access_width);
+		/* Hammer the write through DATA0 */
+		if (!riscv_dm_write(hart->dbg_module, RV_DM_DATA0, value))
+			break;
 	}
 
+	if (len / access_length > 1 && hart->flags & RV_HART_FLAG_ABSTRACTAUTO)
+		riscv_dm_write(hart->dbg_module, RV_DM_ABST_AUTO, 0);
+
 	riscv_csr_write(hart, RV_GPR_A0, &a0_save);
 	riscv_csr_write(hart, RV_GPR_A1, &a1_save);
 }
diff --git a/src/target/riscv_debug.c b/src/target/riscv_debug.c
index 0047b91f1..b90fd5400 100644
--- a/src/target/riscv_debug.c
+++ b/src/target/riscv_debug.c
@@ -682,6 +682,15 @@ static uint32_t riscv_hart_discover_isa(riscv_hart_s *const hart)
 	/* Memory access using just 1 progbuf slot is possible */
 	if (hart->progbuf_size >= 1U)
 		hart->flags |= RV_HART_FLAG_MEMORY_PROGBUF;
+	/* Check via WARL semantics whether abstract autoexec is possible */
+	if (hart->progbuf_size >= 2U) {
+		riscv_dm_write(hart->dbg_module, RV_DM_ABST_AUTO, RV_ABST_AUTO_DATA_MASK);
+		uint32_t abstract_auto = 0;
+		riscv_dm_read(hart->dbg_module, RV_DM_ABST_AUTO, &abstract_auto);
+		if (abstract_auto & RV_ABST_AUTO_DATA0)
+			hart->flags |= RV_HART_FLAG_ABSTRACTAUTO;
+		riscv_dm_write(hart->dbg_module, RV_DM_ABST_AUTO, 0U);
+	}
 	/* Check we have at least enough data registers for arg0 */
 	if (data_registers >= 4)
 		hart->access_width = 128U;
