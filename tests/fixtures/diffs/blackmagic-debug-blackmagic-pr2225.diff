-		result = riscv_csr_read(hart, RV_GPR_A1, &value);
+
+		/* Copy the read value from GPR A1 to DATA0 but do not extract it yet */
+		result = riscv_dm_write(hart->dbg_module, RV_DM_ABST_COMMAND, RV_DM_ABST_CMD_ACCESS_REG | RV_ABST_READ | RV_REG_XFER | RV_ABST_POSTEXEC |
+			RV_REG_ACCESS_32_BIT | RV_GPR_A1);
+		result &= riscv_command_wait_complete(hart);
 		if (!result)
 			break;
+
+		if (use_abstractauto)
+			riscv_dm_write(hart->dbg_module, RV_DM_ABST_AUTO, RV_ABST_AUTO_DATA0);
+	} while(false);
+
+	uint8_t *const data = (uint8_t *)dest;
+	for (size_t offset = 0; offset < len - access_length; offset += access_length) {
+		/* Extract the read value from DATA0 */
+		uint32_t value = 0;
+		if (!riscv_dm_read(hart->dbg_module, RV_DM_DATA0, &value))
+			break;
 		riscv32_unpack_data(data + offset, value, access_width);
 	}
 
+	if (use_abstractauto)
+		riscv_dm_write(hart->dbg_module, RV_DM_ABST_AUTO, 0);
+	/* Get last value read from memory */
+	uint32_t value_last = 0;
+	riscv_dm_read(hart->dbg_module, RV_DM_DATA0, &value_last);
+	riscv32_unpack_data(data + len - access_length, value_last, access_width);
+
 	riscv_csr_write(hart, RV_GPR_A0, &a0_save);
 	riscv_csr_write(hart, RV_GPR_A1, &a1_save);
 }
@@ -682,9 +716,11 @@ static void riscv32_progbuf_mem_write(
 	/* Fill the program buffer */
 	if (!riscv_dm_write(hart->dbg_module, RV_DM_PROGBUF_BASE, progbuf_write))
