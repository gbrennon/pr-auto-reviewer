From 35a3246ed5799752f6419ad12888d0620c4e840b Mon Sep 17 00:00:00 2001
From: Glauber Brennon <glauberbrennon@gmail.com>
Date: Sun, 22 Mar 2026 22:31:29 -0300
Subject: [PATCH] fix(install): resolve RIKKA_DIR path correctly

---
 install.sh | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/install.sh b/install.sh
index 57dffde..9643ae7 100755
--- a/install.sh
+++ b/install.sh
@@ -33,7 +33,7 @@ for arg in "$@"; do
   [[ "$arg" == "--hard-reset" ]] && HARD_RESET=true
 done
 
-RIKKA_DIR="$HOME/Rikka"
+RIKKA_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
 TMP_HELPER="$(mktemp)"
 
 # Atomic hard reset flow
@@ -104,4 +104,4 @@ else
   pipx install . --force >/dev/null 2>&1 &
   spinner $! "Installing Rikka"
   success "Rikka installed!"
-fi
\ No newline at end of file
+fi
-- 
2.53.0

