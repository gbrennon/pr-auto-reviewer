PLATFORM_MODE=both

GITHUB_API_URL=https://api.github.com
GITHUB_OWNER_TOKEN=
GITHUB_REVIEWER_TOKEN=
GITHUB_REVIEWER_USERNAME=

# Per-org token overrides (optional) — for reviewing PRs across multiple GitHub orgs.
# Format: GITHUB_TOKEN_{ORG}_{ROLE}
# Roles: OWNER, REVIEWER, REVIEWER_USERNAME
# When set, overrides the default GITHUB_OWNER_TOKEN / GITHUB_REVIEWER_TOKEN for that org.
# GITHUB_TOKEN_my-org_OWNER=
# GITHUB_TOKEN_my-org_REVIEWER=
# GITHUB_TOKEN_my-org_REVIEWER_USERNAME=

FORGEJO_API_URL=https://codeberg.org/api/v1
FORGEJO_HOST=https://codeberg.org
FORGEJO_OWNER_TOKEN=
FORGEJO_REVIEWER_TOKEN=
FORGEJO_REVIEWER_USERNAME=

# Per-org token overrides for Forgejo/Codeberg (optional).
# Format: FORGEJO_TOKEN_{ORG}_{ROLE}
# FORGEJO_TOKEN_my-org_OWNER=
# FORGEJO_TOKEN_my-org_REVIEWER=
# FORGEJO_TOKEN_my-org_REVIEWER_USERNAME=

LLM_HOST=http://localhost:11434
LLM_MODEL=
POLL_INTERVAL=60

# Repository allow list (optional) — restricts which repositories the polling
# daemon reviews. Comma- or newline-separated entries with platform prefix
# (e.g. github:owner/repo, forgejo:owner/repo, codeberg:owner/repo) or bare
# owner/repo to match across platforms; case-insensitive exact match.
# Leave empty or unset to review every discovered repository.
# Applies to the polling daemon only, not the one-off `review` CLI.
# REPOS_ALLOW_LIST=github:owner/repo-one,forgejo:owner/repo-two

USE_STRICT_FRAGMENT_SELECTION=false
DEBUG=0
