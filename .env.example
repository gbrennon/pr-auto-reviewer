# PR Auto-Reviewer Configuration
#
# Configuration is loaded from (in order of priority):
#   1. ~/.config/pr-auto-reviewer/config (preferred - used by service)
#   2. .env in the repo root (fallback)
#
# The install-service.sh script creates ~/.config/pr-auto-reviewer/config
# if it doesn't exist.

# === FORGEJO/CODEBERG ===
FORGEJO_TOKEN=           # Required - Generate at https://codeberg.org/settings/applications (scopes: repo, read:user)
FORGEJO_MODE=codeberg    # "local" or "codeberg" (default: codeberg)
FORGEJO_HOST=https://codeberg.org/api/v1

# === REVIEWER ===
FORGEJO_REVIEWER_TOKEN=  # Required - Different user's token (scopes: repo)
FORGEJO_REVIEWER_USERNAME=  # Required - Username of reviewer account

# === OLLAMA ===
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=             # Required - Your model (e.g., code-review, llama3.2, qwen2.5-coder:14b)
POLL_INTERVAL=60

# === DEBUG (optional) ===
DEBUG=0