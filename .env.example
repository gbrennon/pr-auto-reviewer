# Codeberg PR AI Auto-Reviewer Configuration

# Required: Codeberg API token
# Generate at: https://codeberg.org/settings/applications
# Required scopes:
#   - user (read)
#   - repository (read, write)
#   - issue (write)
CODEBERG_TOKEN=

# Optional: GitHub PAT (for GitHub repos)
GITHUB_PAT=

# Optional: Ollama settings
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=code-review

# Optional: Poll interval in seconds (default: 60)
POLL_INTERVAL=60
