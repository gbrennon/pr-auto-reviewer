PLATFORM_MODE=both

GITHUB_API_URL=https://api.github.com
GITHUB_OWNER_TOKEN=
GITHUB_REVIEWER_TOKEN=
GITHUB_REVIEWER_USERNAME=

FORGEJO_API_URL=https://codeberg.org/api/v1
FORGEJO_HOST=https://codeberg.org
FORGEJO_OWNER_TOKEN=
FORGEJO_REVIEWER_TOKEN=
FORGEJO_REVIEWER_USERNAME=

LLM_MODE=
LLM_API=http://localhost:11434
LLM_MODEL=
POLL_INTERVAL=60

USE_STRICT_FRAGMENT_SELECTION=false
DEBUG=0

# REVIEW_OUTPUT: where the review result goes
#   (empty)     → publish to the platform (Codeberg/GitHub) via review API
#   terminal    → print to stdout only; no publish, no persistence
#   file:<path> → write JSON to <path>; no publish
REVIEW_OUTPUT=

# LLM backends and their endpoints
#
# LLM_MODE=           → auto-detect: probe /v1/models (llama.cpp) then /api/tags (Ollama)
# LLM_MODE=llama_cpp  → POST {LLM_API}/v1/chat/completions   (OpenAI-compatible)
# LLM_MODE=ollama     → POST {LLM_API}/api/generate           (Ollama native)
#
# LLM_API is the base URL for the LLM server:
#   llama.cpp example:  http://localhost:8081
#   Ollama example:     http://localhost:11434
#
# LLM_MODEL:
#   llama.cpp: can be empty (server serves a single model)
#   Ollama:    required (e.g. qwen3:14b)
