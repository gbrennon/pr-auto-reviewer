# PR Auto-Reviewer Configuration
#
# Configuration is loaded from (in order of priority):
#   1. ~/.config/pr-auto-reviewer/config (preferred - used by service)
#   2. .env in the repo root (fallback)
#
# The install-service.sh script creates ~/.config/pr-auto-reviewer/config
# if it doesn't exist.

# === PLATFORM SELECTION ===
# Set to 'codeberg', 'github', or 'both'
PLATFORM_MODE=codeberg

# === TOKENS (Generic) ===
# These generic variables work for any platform selected in PLATFORM_MODE
PLATFORM_TOKEN=           # Required - Owner account API token
REVIEWER_TOKEN=           # Required - Reviewer account API token
REVIEWER_USERNAME=        # Required - Username of reviewer account

# === TOKENS (Platform-Specific Fallbacks) ===
# If PLATFORM_TOKEN/REVIEWER_TOKEN are not set, the app looks for these:
# Forgejo/Codeberg
FORGEJO_TOKEN=
FORGEJO_REVIEWER_TOKEN=
FORGEJO_REVIEWER_USERNAME=
# GitHub
GITHUB_TOKEN=
GITHUB_REVIEWER_TOKEN=
GITHUB_REVIEWER_USERNAME=

# === HOSTS ===
# Default: https://codeberg.org (for Codeberg) or https://api.github.com (for GitHub)
PLATFORM_API_URL=

# === OLLAMA ===
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=             # Required - Your model (e.g., code-review, llama3.2, qwen2.5-coder:14b)
POLL_INTERVAL=60

# === DEBUG (optional) ===
# Preferred: PROMPT_MODE controls which prompt composition to use: 'monolithic' or 'fragments'
PROMPT_MODE=monolithic
# If true, select fragments strictly based on changed files
USE_STRICT_FRAGMENT_SELECTION=false
DEBUG=0
